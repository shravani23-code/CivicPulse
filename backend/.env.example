MONGODB_URI=your-mongodb-atlas-connection-string

# CORS. The production frontend and localhost:5173/5175 are always
# allowed. FRONTEND_ORIGIN adds extra exact origins (comma-separated),
# e.g. a custom domain. This project's own Vercel preview deployments
# (civic-pulse-*-shravani23-code.vercel.app) are allowed by a strict
# pattern; set CORS_ALLOW_VERCEL_PREVIEWS=false to disable that.
# FRONTEND_ORIGIN=https://your-custom-domain.example
# CORS_ALLOW_VERCEL_PREVIEWS=true

# Signs citizen/admin login tokens — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# The one admin account is created automatically on server startup from
# these two values. There is no public admin registration form.
ADMIN_EMAIL=admin@civicpulse.local
ADMIN_PASSWORD=choose-a-strong-password

# Cloudinary (complaint photo storage — free tier is enough)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------------------------
# OPTIONAL — SMS (mobile OTP verification + SMS copies of notifications)
#
# Leave these unset and everything else still works: in-app
# notifications are always created, OTP endpoints answer 503, no number
# is ever marked verified, and notifications record sms.status
# "not_configured". SMS is only sent to citizens who opted in AND
# verified their number. Never put any of these in VITE_* variables.
# ---------------------------------------------------------------

# --- Option A (recommended for India): MSG91 + TRAI DLT ---------------
# Before anything is delivered you need, on a DLT portal (Jio/Airtel/
# Vi/BSNL...): an approved Principal Entity ID, an approved 6-letter
# sender header, and one approved content template per message below,
# all linked in the MSG91 dashboard. Each template uses ONE variable,
# named var1 in MSG91 (= {#var#} on DLT): the complaint ID, or the code.
# A message kind without a template id is skipped ("template_missing").
#
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_SENDER_ID=CIVPLS
# MSG91_TEMPLATE_OTP=            # Your CivicPulse verification code is {#var#}. It expires in 5 minutes. Do not share it.
# MSG91_TEMPLATE_REGISTERED=     # CivicPulse: Your complaint {#var#} has been registered. Log in to CivicPulse to track its status.
# MSG91_TEMPLATE_UNDER_REVIEW=   # CivicPulse: Your complaint {#var#} requires additional review. No final decision has been made. Log in to view the details.
# MSG91_TEMPLATE_APPROVED=       # CivicPulse: Your complaint {#var#} has been approved for further action. Log in to view the latest update.
# MSG91_TEMPLATE_REJECTED=       # CivicPulse: Your complaint {#var#} was not approved. Log in to CivicPulse to review the reason.
# MSG91_TEMPLATE_IN_PROGRESS=    # CivicPulse: Work has started on your complaint {#var#}. Log in to view the latest update.
# MSG91_TEMPLATE_RESOLVED=       # CivicPulse: Your complaint {#var#} has been marked resolved. Log in to view the update.
# MSG91_TEMPLATE_REOPENED=       # CivicPulse: Your complaint {#var#} has been moved back to Pending. Log in to view the latest update.

# --- Option B: Twilio (free text; India still requires DLT via Twilio) -
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Use ONE of the next two:
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Delivery reports ---------------------------------------------------
# Turns on POST /api/sms/delivery-report. In MSG91 add a webhook
# (SMS -> "On Report Received", JSON) to:
#   https://<backend>/api/sms/delivery-report?secret=<this value>
# Without it, sent messages stay "accepted" — never shown as delivered.
# SMS_WEBHOOK_SECRET=long-random-string

# --- Reliability (defaults shown) -------------------------------------
# SMS_TIMEOUT_MS=8000
# SMS_MAX_ATTEMPTS=3             # retries only timeouts / network / HTTP 429 / 5xx

# Optional: separate key for hashing OTP codes (defaults to JWT_SECRET)
# OTP_SECRET=another-long-random-string

# ---------------------------------------------------------------
# OPTIONAL — Suspicious-submission review thresholds (defaults shown)
# See services/suspicionDetector.js for what each rule does.
# ---------------------------------------------------------------
# SUSPICION_DUPLICATE_WINDOW_HOURS=72
# SUSPICION_DUPLICATE_SIMILARITY=0.8
# SUSPICION_RELATED_WINDOW_DAYS=7
# SUSPICION_RELATED_SIMILARITY=0.5
# SUSPICION_BURST_WINDOW_MINUTES=60
# SUSPICION_BURST_MAX=4
